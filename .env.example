# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# NEVER put GEMINI_API_KEY in the frontend or the APK. It stays on the server only.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this backend server is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_API_BASE_URL: Backend server URL for Android APK and client fetch requests.
# Empty string for same-origin web deployment (relative /api/* calls),
# or full URL (e.g. https://your-server.run.app) when built into the Android APK.
VITE_API_BASE_URL=""

# Gemini Model configurations
GEMINI_CHAT_MODEL="gemini-3.1-flash-lite"
GEMINI_FALLBACK_MODEL="gemini-3.8-flash"
GEMINI_TTS_MODEL="gemini-3.8-flash-lite-tts"
